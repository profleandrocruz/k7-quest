{
  "name": "k7-quest",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "K7 Quest: Echoes of Generations - plataforma 2D onde a evolucao das eras de videogame e metafora das fases da vida.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "levels:export": "node tools/export-tiled-levels.mjs",
    "levels:import": "node tools/import-tiled-levels.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "^9.0.0",
    "matter-js": "^0.20.0",
    "phaser": "^3.88.0",
    "pixi.js": "^8.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.173.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/matter-js": "^0.19.8",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.173.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.2",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
