# junto. Ver a secao "Direitos autorais" do README para o procedimento de remocao.
the-art-of-game-design-a-book-of-lenses_3.pdf

# Logs
logs/
*.log
npm-debug.log*

# Saves de jogador nunca versionados
k7-quest-save*.json

# Notas de trabalho pessoal.
# Sem aspas: o gitignore nao entende "aspas" — elas seriam parte do nome do arquivo.

# Editores
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# Sistema operacional
.DS_Store
Thumbs.db

